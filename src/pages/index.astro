---
import Header from '../components/Header/Header.astro';
import Hero from '../components/Hero/Hero.astro';
import OurServices from '../components/OurServices/OurServices.astro';
import ServiceDetails from '../components/ServiceDetails/ServiceDetails.astro';
import { services } from '../data/services.js';
import '../styles/global.css';
---

<!doctype html>
<html lang="es-CL">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Oclock Servicios</title>
    </head>
    <body>
        <Header />
        <main id="inicio">
            <Hero />
            <OurServices />

            {services.map((service, index) => (
                <ServiceDetails {...service} serviceNumber={index + 1} reverse={index % 2 !== 0} />
            ))}
        </main>
    </body>
</html>
