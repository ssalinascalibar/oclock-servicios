---
import './service-details.css';

interface Props {
    id: string;
    label: string;
    title: string;
    fullDescription: string;
    features: {
        title: string;
        description: string;
    }[];
    specifications?: {
        label: string;
        value: string;
    }[];
    detailImage: string;
    detailImageAlt: string;
    serviceNumber: number;
    reverse?: boolean;
}

const {
    id,
    label,
    title,
    fullDescription,
    features,
    specifications = [],
    detailImage,
    detailImageAlt,
    serviceNumber,
    reverse = false,
} = Astro.props;
---

<section
    id={id}
    class:list={['service-details', { 'service-details-reverse': reverse }]}
    aria-labelledby={`${id}-title`}
>
    <div class="service-details-container">
        <div class="service-details-media">
            <img
                class="service-details-image"
                src={detailImage}
                alt={detailImageAlt}
                width="1200"
                height="1500"
                loading="lazy"
                decoding="async"
            />
        </div>

        <div class="service-details-content">
            <header class="service-details-heading">
                <p class="service-details-intro">
                    <span class="service-details-number">{String(serviceNumber).padStart(2, '0')}</span>
                    <span>{label}</span>
                </p>
                <h2 class="service-details-title" id={`${id}-title`}>{title}</h2>
            </header>
            {fullDescription && (
                <p class="service-details-description">{fullDescription}</p>
            )}
            {features.length > 0 && (
                <div class="service-details-feature-group">
                    <hr class="service-details-divider" />
                    <h3 class="service-details-features-title">Características del servicio</h3>
                    <ul class="service-details-features" role="list">
                        {features.map((feature) => (
                            <li class="service-details-feature">
                                <svg class="service-details-feature-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <circle cx="12" cy="12" r="9" />
                                    <path d="m8 12 2.5 2.5L16 9" />
                                </svg>
                                <div class="service-details-feature-content">
                                    <h4 class="service-details-feature-title">{feature.title}</h4>
                                    <p class="service-details-feature-description">{feature.description}</p>
                                </div>
                            </li>
                        ))}
                    </ul>
                </div>
            )}
            {specifications.length > 0 && (
                <div class="service-details-specifications">
                    <h3 class="service-details-specifications-title">Especificaciones técnicas</h3>
                    <dl class="service-details-specification-list">
                        {specifications.map((specification) => (
                            <div class="service-details-specification">
                                <dt class="service-details-specification-label">{specification.label}</dt>
                                <dd class="service-details-specification-value">{specification.value}</dd>
                            </div>
                        ))}
                    </dl>
                </div>
            )}
            <!-- Destino pendiente de implementar: sección Contacto. -->
            <a class="service-details-link" href="#contacto">
                Solicitar una cotización
                <span class="service-details-link-arrow" aria-hidden="true">→</span>
            </a>
        </div>
    </div>
</section>
